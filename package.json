{
  "name": "xuri-planner",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "description": "序日：支持 iPhone 主屏幕安装与离线使用的日程和项目管理 PWA",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "build": "node scripts/build-static.mjs",
    "test:pwa": "python3 -u tests/pwa_browser_test.py",
    "test:upgrade": "python3 -u tests/pwa_upgrade_test.py",
    "test:push-client": "python3 -u tests/push_client_test.py",
    "test:push-backend": "node tests/push-backend.test.mjs",
    "test": "node tests/model.test.mjs && node tests/store.test.mjs",
    "test:browser": "python3 -u tests/browser_test.py"
  }
}
